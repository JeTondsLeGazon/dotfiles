layout {
    swap_floating_layout {
      floating_panes {
          pane  {
            x "10%"
            y "10%"
            width "80%"
            height "80%"
          }
      }
    }

    swap_tiled_layout name="side-by-side" {
        tab max_panes=2 {
            pane split_direction="vertical" {
                pane
                pane
            }
        }
        tab max_panes=4 {
            pane split_direction="vertical" {
                pane
                pane
                pane
            }
        }
        tab {
            pane split_direction="vertical" {
                pane
                pane
                pane
                pane
            }
        }
    }

    swap_tiled_layout name="stacked" {
        tab max_panes=8 {
            pane stacked=true {
                pane expanded=true
                pane
            }
        }
    }

    swap_tiled_layout name="top-bottom" {
        tab max_panes=2 {
            pane split_direction="horizontal" {
                pane
                pane
            }
        }
        tab max_panes=4 {
            pane split_direction="horizontal" {
                pane
                pane
                pane
            }
        }
        tab {
            pane split_direction="horizontal" {
                pane
                pane
                pane
                pane
            }
        }
    }

    swap_tiled_layout name="main-stacked" {
        tab {
            pane split_direction="vertical" {
                pane size="60%"
                pane stacked=true size="40%" {
                    children
                }
            }
        }
    }
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        // pane size=1 borderless=true {
        //     plugin location="status-bar"
        // }
    }
}
